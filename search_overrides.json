  "recipes": [
    {
      "id": "ls-readable",
      "command": "ls",
      "description": "List file details with human-readable sizes.",
      "effect": "get",
      "terms": [
        "files",
        "size",
        "permissions",
        "readable"
      ],
      "options": [
        {
          "flag": "-l"
        },
        {
          "flag": "-h"
        }
      ]
    },
    {
      "id": "du-summary",
      "command": "du",
      "description": "Show a total directory size in human-readable units.",
      "effect": "get",
      "terms": [
        "disk",
        "space",
        "directory",
        "size",
        "total"
      ],
      "options": [
        {
          "flag": "-s"
        },
        {
          "flag": "-h"
        }
      ]
    },
    {
      "id": "ping-paced",
      "command": "ping",
      "description": "Test reachability with a limited number of spaced ICMP probes.",
      "effect": "get",
      "terms": [
        "network",
        "reachable",
        "test",
        "icmp",
        "count",
        "interval"
      ],
      "options": [
        {
          "flag": "-c",
          "arguments": [
            "Probe count"
          ]
        },
        {
          "flag": "-i",
          "arguments": [
            "Interval in seconds"
          ]
        }
      ]
    },
    {
      "id": "docker-follow-tail",
      "command": "docker logs",
      "description": "Follow container logs after showing a selected number of recent lines.",
      "effect": "get",
      "terms": [
        "container",
        "logs",
        "tail",
        "follow",
        "monitor"
      ],
      "options": [
        {
          "flag": "--follow"
        },
        {
          "flag": "--tail",
          "arguments": [
            "Recent line count"
          ]
        }
      ]
    },
    {
      "id": "kubectl-pods-wide",
      "command": "kubectl get",
      "description": "List pods across namespaces with node and IP details.",
      "effect": "get",
      "terms": [
        "kubernetes",
        "pods",
        "namespaces",
        "nodes",
        "ip",
        "inspect"
      ],
      "positionals": [
        "pods"
      ],
      "options": [
        {
          "flag": "--all-namespaces"
        },
        {
          "flag": "-o",
          "values": [
            "wide"
          ]
        }
      ]
    },
    {
      "id": "aws-instance-fields",
      "command": "aws ec2 describe-instances",
      "description": "Inspect selected EC2 instances and choose response fields with JMESPath.",
      "effect": "get",
      "terms": [
        "aws",
        "ec2",
        "instances",
        "inspect",
        "filter",
        "query",
        "jmespath"
      ],
      "options": [
        {
          "flag": "--filters",
          "arguments": [
            "Instance filters"
          ]
        },
        {
          "flag": "--query",
          "arguments": [
            "JMESPath expression"
          ]
        }
      ]
    }
